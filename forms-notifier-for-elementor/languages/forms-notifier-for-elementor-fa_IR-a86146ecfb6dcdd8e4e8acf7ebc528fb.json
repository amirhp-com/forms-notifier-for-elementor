0627\u062a\u0635\u0627\u0644\u00bb \u0631\u0648\u0634\u0646 \u06a9\u0646\u06cc\u062f."],"No admins yet":["\u0647\u0646\u0648\u0632 \u0645\u062f\u06cc\u0631\u06cc \u0627\u0636\u0627\u0641\u0647 \u0646\u0634\u062f\u0647 \u0627\u0633\u062a"],"Admins can read submissions in the chat, press action buttons and open the mini app.":["\u0645\u062f\u06cc\u0631\u0627\u0646 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u0646\u062f \u0627\u0631\u0633\u0627\u0644\u06cc\u200c\u0647\u0627 \u0631\u0627 \u062f\u0631 \u06af\u0641\u062a\u200c\u0648\u06af\u0648 \u0628\u062e\u0648\u0627\u0646\u0646\u062f\u060c \u062f\u06a9\u0645\u0647\u200c\u0647\u0627\u06cc \u0639\u0645\u0644\u06cc\u0627\u062a \u0631\u0627 \u0628\u0632\u0646\u0646\u062f \u0648 \u0645\u06cc\u0646\u06cc\u200c\u0627\u067e \u0631\u0627 \u0628\u0627\u0632 \u06a9\u0646\u0646\u062f."],"Person":["\u0641\u0631\u062f"],"Id":["\u0634\u0646\u0627\u0633\u0647"],"WordPress user":["\u06a9\u0627\u0631\u0628\u0631 \u0648\u0631\u062f\u067e\u0631\u0633"],"May":["\u0627\u062c\u0627\u0632\u0647"],"View and act":["\u062f\u06cc\u062f\u0646 \u0648 \u0627\u0646\u062c\u0627\u0645 \u0639\u0645\u0644\u06cc\u0627\u062a"],"View":["\u0641\u0642\u0637 \u062f\u06cc\u062f\u0646"],"People without a WordPress account can be added by their numeric id on the settings tab.":["\u06a9\u0633\u0627\u0646\u06cc \u0631\u0627 \u06a9\u0647 \u062d\u0633\u0627\u0628 \u0648\u0631\u062f\u067e\u0631\u0633 \u0646\u062f\u0627\u0631\u0646\u062f \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0627 \u0634\u0646\u0627\u0633\u0647 \u0639\u062f\u062f\u06cc\u200c\u0634\u0627\u0646 \u062f\u0631 \u0632\u0628\u0627\u0646\u0647 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0627\u0636\u0627\u0641\u0647 \u06a9\u0646\u06cc\u062f."],"Add admin":["\u0627\u0641\u0632\u0648\u062f\u0646 \u0645\u062f\u06cc\u0631"],"channel state\u0004Off":["\u062e\u0627\u0645\u0648\u0634"],"Connection updated.":["\u0627\u062a\u0635\u0627\u0644 \u0628\u0647\u200c\u0631\u0648\u0632 \u0634\u062f."],"No bot token yet":["\u0647\u0646\u0648\u0632 \u062a\u0648\u06a9\u0646 \u0631\u0628\u0627\u062a \u0648\u0627\u0631\u062f \u0646\u0634\u062f\u0647 \u0627\u0633\u062a"],"Enter the token on the settings tab first.":["\u0627\u0648\u0644 \u062a\u0648\u06a9\u0646 \u0631\u0627 \u062f\u0631 \u0632\u0628\u0627\u0646\u0647 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0648\u0627\u0631\u062f \u06a9\u0646\u06cc\u062f."],"Open settings":["\u0628\u0627\u0632 \u06a9\u0631\u062f\u0646 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a"],"The messenger reported a webhook error":["\u067e\u06cc\u0627\u0645\u200c\u0631\u0633\u0627\u0646 \u062e\u0637\u0627\u06cc \u0648\u0628\u200c\u0647\u0648\u06a9 \u06af\u0632\u0627\u0631\u0634 \u06a9\u0631\u062f"],"Bot":["\u0631\u0628\u0627\u062a"],"Reconnect":["\u0627\u062a\u0635\u0627\u0644 \u062f\u0648\u0628\u0627\u0631\u0647"],"Use a webhook":["\u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0648\u0628\u200c\u0647\u0648\u06a9"],"Use regular checks":["\u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0628\u0631\u0631\u0633\u06cc \u062f\u0648\u0631\u0647\u200c\u0627\u06cc"],"Check now":["\u0628\u0631\u0631\u0633\u06cc \u06a9\u0646"],"Receives messages by":["\u0631\u0648\u0634 \u062f\u0631\u06cc\u0627\u0641\u062a \u067e\u06cc\u0627\u0645"],"Why":["\u062f\u0644\u06cc\u0644"],"Webhook set":["\u0648\u0628\u200c\u0647\u0648\u06a9 \u062a\u0646\u0638\u06cc\u0645 \u0634\u062f\u0647"],"Waiting updates":["\u0628\u0647\u200c\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc\u200c\u0647\u0627\u06cc \u062f\u0631 \u0627\u0646\u062a\u0638\u0627\u0631"],"Last check":["\u0622\u062e\u0631\u06cc\u0646 \u0628\u0631\u0631\u0633\u06cc"],"Mini app address":["\u0646\u0634\u0627\u0646\u06cc \u0645\u06cc\u0646\u06cc\u200c\u0627\u067e"],"There is no such bot":["\u0686\u0646\u06cc\u0646 \u0631\u0628\u0627\u062a\u06cc \u0648\u062c\u0648\u062f \u0646\u062f\u0627\u0631\u062f"],"All channels":["\u0647\u0645\u0647 \u06a9\u0627\u0646\u0627\u0644\u200c\u0647\u0627"]}}}