. \u06af\u0641\u062a\u200c\u0648\u06af\u0648\u0647\u0627\u06cc \u062a\u0627\u0632\u0647 \u06cc\u0627 \u062a\u063a\u06cc\u06cc\u0631\u06a9\u0631\u062f\u0647: %s."],"This receiver is already in the list.":["\u0627\u06cc\u0646 \u06af\u06cc\u0631\u0646\u062f\u0647 \u0627\u0632 \u0642\u0628\u0644 \u062f\u0631 \u0641\u0647\u0631\u0633\u062a \u0647\u0633\u062a."],"%s gets the messages of every form now.":["\u0627\u0632 \u0627\u06cc\u0646 \u067e\u0633 \u067e\u06cc\u0627\u0645\u200c\u0647\u0627\u06cc \u0647\u0645\u0647 \u0641\u0631\u0645\u200c\u0647\u0627 \u0628\u0647 %s \u0645\u06cc\u200c\u0631\u0633\u062f."],"Rename":["\u062a\u063a\u06cc\u06cc\u0631 \u0646\u0627\u0645"],"Only the name in this panel changes.":["\u0641\u0642\u0637 \u0646\u0627\u0645 \u062f\u0631 \u0627\u06cc\u0646 \u067e\u0646\u0644 \u062a\u063a\u06cc\u06cc\u0631 \u0645\u06cc\u200c\u06a9\u0646\u062f."],"Forget %s?":["%s \u0641\u0631\u0627\u0645\u0648\u0634 \u0634\u0648\u062f\u061f"],"It disappears from this list until the bot hears from it again. Receivers you already added keep working.":["\u062a\u0627 \u0648\u0642\u062a\u06cc \u0631\u0628\u0627\u062a \u062f\u0648\u0628\u0627\u0631\u0647 \u0627\u0632 \u0622\u0646 \u067e\u06cc\u0627\u0645\u06cc \u0646\u0628\u06cc\u0646\u062f\u060c \u0627\u0632 \u0627\u06cc\u0646 \u0641\u0647\u0631\u0633\u062a \u062d\u0630\u0641 \u0645\u06cc\u200c\u0634\u0648\u062f. \u06af\u06cc\u0631\u0646\u062f\u0647\u200c\u0647\u0627\u06cc\u06cc \u06a9\u0647 \u0642\u0628\u0644\u0627\u064b \u0627\u0636\u0627\u0641\u0647 \u06a9\u0631\u062f\u0647\u200c\u0627\u06cc\u062f \u0647\u0645\u0686\u0646\u0627\u0646 \u06a9\u0627\u0631 \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f."],"Forget":["\u0641\u0631\u0627\u0645\u0648\u0634 \u06a9\u0631\u062f\u0646"],"No chats match these filters":["\u0647\u06cc\u0686 \u06af\u0641\u062a\u200c\u0648\u06af\u0648\u06cc\u06cc \u0628\u0627 \u0627\u06cc\u0646 \u0641\u06cc\u0644\u062a\u0631\u0647\u0627 \u067e\u06cc\u062f\u0627 \u0646\u0634\u062f"],"Clear filters":["\u067e\u0627\u06a9 \u06a9\u0631\u062f\u0646 \u0641\u06cc\u0644\u062a\u0631\u0647\u0627"],"No chats found yet":["\u0647\u0646\u0648\u0632 \u06af\u0641\u062a\u200c\u0648\u06af\u0648\u06cc\u06cc \u067e\u06cc\u062f\u0627 \u0646\u0634\u062f\u0647 \u0627\u0633\u062a"],"Send \/start to the bot from your own account, then press \"Find chats\".":["\u0627\u0632 \u062d\u0633\u0627\u0628 \u062e\u0648\u062f\u062a\u0627\u0646 \u200e\/start \u0631\u0627 \u0628\u0631\u0627\u06cc \u0631\u0628\u0627\u062a \u0628\u0641\u0631\u0633\u062a\u06cc\u062f\u060c \u0633\u067e\u0633 \u00ab\u067e\u06cc\u062f\u0627 \u06a9\u0631\u062f\u0646 \u06af\u0641\u062a\u200c\u0648\u06af\u0648\u0647\u0627\u00bb \u0631\u0627 \u0628\u0632\u0646\u06cc\u062f."],"Chats":["\u06af\u0641\u062a\u200c\u0648\u06af\u0648\u0647\u0627"],"Chat":["\u06af\u0641\u062a\u200c\u0648\u06af\u0648"],"Last seen":["\u0622\u062e\u0631\u06cc\u0646 \u0628\u0627\u0632\u062f\u06cc\u062f"],"Bot left":["\u0631\u0628\u0627\u062a \u062e\u0627\u0631\u062c \u0634\u062f\u0647"],"Bot blocked":["\u0631\u0628\u0627\u062a \u0645\u0633\u062f\u0648\u062f \u0634\u062f\u0647"],"Closed":["\u0628\u0633\u062a\u0647\u200c\u0634\u062f\u0647"],"Use as receiver":["\u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0628\u0647\u200c\u0639\u0646\u0648\u0627\u0646 \u06af\u06cc\u0631\u0646\u062f\u0647"],"They can no longer use admin commands, buttons or the mini app. Open sessions end at once.":["\u062f\u06cc\u06af\u0631 \u0646\u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0627\u0632 \u0641\u0631\u0645\u0627\u0646\u200c\u0647\u0627\u06cc \u0645\u062f\u06cc\u0631\u06cc\u062a\u06cc\u060c \u062f\u06a9\u0645\u0647\u200c\u0647\u0627 \u06cc\u0627 \u0645\u06cc\u0646\u06cc\u200c\u0627\u067e \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u062f. \u0646\u0634\u0633\u062a\u200c\u0647\u0627\u06cc \u0628\u0627\u0632 \u0647\u0645\u0627\u0646 \u0644\u062d\u0638\u0647 \u067e\u0627\u06cc\u0627\u0646 \u0645\u06cc\u200c\u06cc\u0627\u0628\u0646\u062f."],"Link your account":["\u067e\u06