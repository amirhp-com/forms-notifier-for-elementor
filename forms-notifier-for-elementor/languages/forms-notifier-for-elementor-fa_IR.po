#. Plugin Name of the plugin
#: forms-notifier-for-elementor.php
msgid "Forms Notifier for Elementor"
msgstr "اطلاع‌رسان فرم‌های المنتور"

#. Plugin URI of the plugin
#: forms-notifier-for-elementor.php
msgid "https://github.com/amirhp-com/forms-notifier-for-elementor"
msgstr "https://github.com/amirhp-com/forms-notifier-for-elementor"

#. Description of the plugin
#: forms-notifier-for-elementor.php
msgid "Send Elementor form submissions to Telegram, Bale, SMS, WhatsApp, email and webhooks, with templates, logs and retries."
msgstr "ارسالی‌های فرم المنتور را به تلگرام، بله، پیامک، واتس‌اپ، ایمیل و وب‌هوک بفرستید؛ با قالب پیام، گزارش ارسال و تلاش دوباره."

#. Author of the plugin
#: forms-notifier-for-elementor.php
msgid "Amirhossein Hosseinpour"
msgstr "امیرحسین حسین‌پور"

#. Author URI of the plugin
#: forms-notifier-for-elementor.php
msgid "https://amirhp.com/"
msgstr "https://amirhp.com/"

#. translators: %1$s: minimum PHP version, %2$s: minimum WordPress version
#: forms-notifier-for-elementor.php:42
#, php-format
msgid "Forms Notifier for Elementor needs PHP %1$s or newer and WordPress %2$s or newer."
msgstr "افزونه اطلاع‌رسان فرم‌های المنتور به PHP نسخه %1$s یا بالاتر و وردپرس نسخه %2$s یا بالاتر نیاز دارد."

