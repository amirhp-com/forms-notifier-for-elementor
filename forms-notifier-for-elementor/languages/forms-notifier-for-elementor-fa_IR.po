msgid "When you send a form we store: %1$s. If you are logged in we also store your user account."
msgstr "وقتی فرمی را می‌فرستید، این موارد را ذخیره می‌کنیم: %1$s. اگر وارد حساب کاربری خود شده باشید، حساب کاربری‌تان هم ذخیره می‌شود."

#. translators: %1$d: number of days
#: includes/Privacy/Privacy.php:190
#, php-format
msgid "Submissions are deleted after %1$d day."
msgid_plural "Submissions are deleted after %1$d days."
msgstr[0] "ارسالی‌ها پس از %1$d روز حذف می‌شوند."
msgstr[1] "ارسالی‌ها پس از %1$d روز حذف می‌شوند."

#: includes/Privacy/Privacy.php:193
msgid "Submissions are kept until they are deleted by us or until you ask us to delete them."
msgstr "ارسالی‌ها تا وقتی ما حذفشان کنیم یا شما درخواست حذفشان را بدهید نگه داشته می‌شوند."

#: includes/Privacy/Privacy.php:195
msgid "Forms you send are forwarded to us. The submissions themselves are not stored on this site."
msgstr "فرم‌هایی که می‌فرستید برای ما ارسال می‌شوند. خود ارسالی‌ها در این سایت ذخیره نمی‌شوند."

#. translators: %1$s: list of services
#: includes/Privacy/Privacy.php:207
#, php-format
msgid "The content of a form may be sent to our team, and a confirmation to you, through these services: %1$s."
msgstr "ممکن است محتوای فرم برای تیم ما و یک پیام تأیید برای شما از طریق این سرویس‌ها فرستاده شود: %1$s."

#. translators: %1$d: number of days
#: includes/Privacy/Privacy.php:215
#, php-format
msgid "A log of sent messages with their recipients is kept for %1$d day."
msgid_plural "A log of sent messages with their recipients is kept for %1$d days."
msgstr[0] "گزارش پیام‌های ارسال‌شده همراه با گیرنده‌هایشان %1$d روز نگه داشته می‌شود."
msgstr[1] "گزارش پیام‌های ارسال‌شده همراه با گیرنده‌هایشان %1$d روز نگه داشته می‌شود."

#. translators: %1$d: number of days
#: includes/Privacy/Privacy.php:223
#, php-format
msgid "The text of each message, with the content of the form, is kept in the message log for %1$d day."
msgid_plural "The text of each message, with the content of the form, is kept in the message log for %1$d days."
msgstr[0] "متن هر پیام، همراه با محتوای فرم، %1$d روز در گزارش پیام‌ها نگه داشته می‌شود."
msgstr[1] "متن هر پیام، همراه با محتوای فرم، %1$d روز در گزارش پیام‌ها نگه داشته می‌شود."

#: includes/Privacy/Privacy.php:226
msgid "The text of each message, with the content of the form, is kept in the message log until it is deleted."
msgstr "متن هر پیام، همراه با محتوای فرم، تا زمان حذف در گزارش پیام‌ها نگه داشته می‌شود."

#: includes/Privacy/Privacy.php:229
msgid "The text below follows the current settings of the plugin. Add the services you use and the reason you need the data."
msgstr "متن زیر مطابق تنظیمات فعلی افزونه است. سرویس‌هایی را که استفاده می‌کنید و دلیل نیازتان به این داده‌ها را به آن اضافه کنید."

