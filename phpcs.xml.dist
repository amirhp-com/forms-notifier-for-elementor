<?xml version="1.0"?>
<ruleset name="Forms Notifier for Elementor">
	<description>Coding standard of the plugin.</description>

	<file>forms-notifier-for-elementor</file>
	<exclude-pattern>*/languages/*</exclude-pattern>
	<exclude-pattern>*\.js$</exclude-pattern>
	<exclude-pattern>*\.css$</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="WordPress-Extra">
		<!-- Class files follow the PSR-4 autoloader. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Short arrays are allowed, Yoda conditions are not required. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="WordPress.PHP.YodaConditions"/>
		<!-- Short ternaries are readable for plain fallbacks. -->
		<exclude name="Universal.Operators.DisallowShortTernary"/>
		<!-- Contract methods are named after the type they return. -->
		<exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
		<!-- The plugin reads its own tables; object caching is decided per query. -->
		<exclude name="WordPress.DB.DirectDatabaseQuery"/>
	</rule>

	<!-- PHPCompatibilityWP extends this standard; either package satisfies it. -->
	<rule ref="PHPCompatibility"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="forms-notifier-for-elementor"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="fnfe"/>
				<element value="FNFE"/>
				<element value="AmirhpCom\FormsNotifier"/>
			</property>
		</properties>
	</rule>
</ruleset>
